#!/bin/bash
#SBATCH --job-name=pmpnn-exp2-boltz
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32g
#SBATCH --gres=gpu:a5000:1
#SBATCH --time=08:00:00
#SBATCH --array=10

# Boltz structure prediction for the sequences generated by the models
# produced by Experiment 2 (finetuning).
#
# Each array task first converts the FASTA files under
# models/exp2_finetuning/<model_name>/eval/seqs/ (produced by
# scripts/exp2_finetuning_02_gen_monomers.sbatch) into per-sequence Boltz YAML inputs
# under models/exp2_finetuning/<model_name>/eval/seqs_boltz/ via
# `pmpnn-to_boltz` (see src/gen/to_boltz.py), then runs `boltz predict` on
# that directory and writes the predicted structures to
# models/exp2_finetuning/<model_name>/eval/structs_boltz/
#
# The model_name list follows the same naming convention used by
# scripts/exp1_data_fraction_01_train.sbatch, scripts/exp2_finetuning_01_eval.sbatch
# and scripts/exp2_finetuning_02_gen_monomers.sbatch.
#
# Submit from the repo root: sbatch scripts/exp2_finetuning_03_boltz.sbatch
# The production partition has 6 schedulable GPUs (4x A5000, 2x A4000), so
# the array is throttled to 6 concurrent tasks (%6).

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$(pwd)}"

mkdir -p logs

source .venv/bin/activate

BOLTZ_BIN="$(command -v boltz || echo "${HOME}/.local/bin/boltz")"

MODEL_NAMES=(
    oa1_seed0 oa1_seed1 oa1_seed2
    oa3_seed0 oa3_seed1 oa3_seed2
    vanilla3
    gat3_seed0 gat3_seed1 gat3_seed2
    native
)

MODEL_NAME=${MODEL_NAMES[$SLURM_ARRAY_TASK_ID]}

echo "Task ${SLURM_ARRAY_TASK_ID}: MODEL_NAME=${MODEL_NAME}"

MODEL_DIR="models/exp2_finetuning/${MODEL_NAME}"
FASTA_DIR="${MODEL_DIR}/eval/seqs"
SEQS_DIR="${MODEL_DIR}/eval/seqs_boltz"
OUTPUT_DIR="${MODEL_DIR}/eval/structs_boltz"
PREDICTIONS_DIR="${OUTPUT_DIR}/boltz_results_seqs_boltz/predictions"

if [ ! -d "${FASTA_DIR}" ] || [ -z "$(ls -A "${FASTA_DIR}" 2>/dev/null)" ]; then
    echo "Task ${SLURM_ARRAY_TASK_ID}: ${FASTA_DIR} does not exist or is empty, skipping." >&2
    exit 1
fi

if [ ! -d "${SEQS_DIR}" ] || [ -z "$(ls -A "${SEQS_DIR}" 2>/dev/null)" ]; then
    pmpnn-to_boltz "${FASTA_DIR}" --out_dir "${SEQS_DIR}"
fi

N_INPUTS=$(find "${SEQS_DIR}" -maxdepth 1 -name '*.yaml' | wc -l)
N_DONE=0
if [ -d "${PREDICTIONS_DIR}" ]; then
    N_DONE=$(find "${PREDICTIONS_DIR}" -mindepth 1 -maxdepth 1 -type d | wc -l)
fi

if [ "${N_DONE}" -ge "${N_INPUTS}" ] && [ "${N_INPUTS}" -gt 0 ]; then
    echo "Task ${SLURM_ARRAY_TASK_ID}: ${PREDICTIONS_DIR} already has all ${N_INPUTS} prediction(s), skipping."
    exit 0
fi

mkdir -p "${OUTPUT_DIR}"

"${BOLTZ_BIN}" predict "${SEQS_DIR}" --out_dir "${OUTPUT_DIR}"
