# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
wheels/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# ── Environment (uv) ──────────────────────────────────────────────────────
.venv/
# uv.lock is intentionally tracked

# ── Downloaded assets (see Makefile: `make data`, `make ckpt`) ────────────
data/
index/
ckpt/
*.tar.gz

# ── Model weights & training state ────────────────────────────────────────
# Everything under models/ is ignored EXCEPT each run's best.pt checkpoint,
# which is tracked on purpose so the trained models ship with the repo.
# Note the mechanics: `models/**` (not `models/`) ignores the *contents*
# rather than the directory, and `!models/**/` re-includes directories, so
# git still descends into them -- a file cannot be re-included once a parent
# directory is excluded. The best.pt negation must stay AFTER `*.pt`, since
# the last matching pattern wins.
models/**
!models/**/
*.pt
*.pth
*.safetensors
# Root-level only: a bare `model_weights/` would block descent into each
# run's model_weights/ directory and so hide its best.pt.
/model_weights/
!models/**/best.pt

# ── Datasets / cached tensors & arrays ────────────────────────────────────
*.h5
*.hdf5
*.npy
*.npz

# ── Run logs & tracking ───────────────────────────────────────────────────
/wandb/
*.log
log.txt
slurm-*.out
*.sbatch.out
*.sbatch.err

# ── Local scratch ─────────────────────────────────────────────────────────
/scratch/
/tmp/
.DS_Store

# The `data` symlink itself; its target is ignored by `data/` above
data
